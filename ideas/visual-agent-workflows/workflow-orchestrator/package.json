{
  "name": "workflow-orchestrator",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/core",
    "packages/server",
    "packages/web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm run dev -w @orch/server\" \"npm run dev -w @orch/web\"",
    "dev:sample": "node scripts/prepare-sample.mjs && ORCH_PROJECT_ROOT=.data/sample-project ORCH_FAKE=1 ORCH_FAKE_DELAY_MS=8000 npm run dev",
    "scan": "npm run scan -w @orch/server --",
    "wf": "npm run wf -w @orch/server --",
    "smoke": "npm run smoke -w @orch/core",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces",
    "test": "vitest run",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/picomatch": "4.0.3",
    "concurrently": "10.0.6",
    "picomatch": "4.0.7",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  },
  "overrides": {
    "dompurify": "3.4.16"
  }
}
